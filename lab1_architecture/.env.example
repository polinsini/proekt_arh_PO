# docker network containing the five practice01-* database containers
DB_NETWORK=lab1-shared
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
INTERNAL_TOKEN=CHANGE_ME_ANOTHER_RANDOM_SECRET
DEMO_USER=student
DEMO_PASSWORD=CHANGE_ME
# Set actual PostgreSQL password from the running PostgreSQL container
PG_DSN=postgresql://admin:CHANGE_ME@practice01-postgres:5432/practice_db
ES_URL=http://practice01-elasticsearch:9200
REDIS_URL=redis://:mypassword@practice01-redis:6379/0
